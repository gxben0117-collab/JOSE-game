{
  "name": "jose-phantom-beast-expedition",
  "version": "0.25.0",
  "private": true,
  "description": "Static tactical RPG with directional motion combat, element projectiles, a 21x10 battlefield, campaign progression, fusion and skill trees.",
  "scripts": {
    "start": "python -m http.server 4173 --bind 127.0.0.1",
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/test.mjs",
    "test:difficulty": "node scripts/audit-difficulty.mjs",
    "report:balance": "node scripts/report-balance.mjs --write",
    "report:simulation": "node scripts/simulate-tactics.mjs --runs=255 --report",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:manual": "node scripts/manual-combat-soak.mjs --runs=100"
  },
  "engines": { "node": ">=18" }
}
